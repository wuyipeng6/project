# 核心：忽略Output文件夹（所有层级）
Output/

# -------------------------- 通用忽略项 --------------------------
# 日志文件
*.log
logs/

# 缓存/临时文件
*.tmp
*.temp
.cache/
.tmp/

# 编辑器配置（VS Code）
.vscode/
!.vscode/settings.json  # 保留settings.json（可选）
!.vscode/extensions.json # 保留extensions.json（可选）

# IDE配置（IntelliJ/IDEA）
.idea/
*.iml
*.ipr
*.iws

# 操作系统文件
.DS_Store       # Mac
Thumbs.db       # Windows